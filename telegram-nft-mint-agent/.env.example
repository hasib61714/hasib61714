# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather
# শুধু এই chat id গুলো বট কে কমান্ড দিতে পারবে (comma separated). খালি রাখলে বট কাউকেই মানবে না।
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------- AI (natural language -> command) ----------
# anthropic | openai | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---------- Chain ----------
CHAIN_ID=1
# একাধিক RPC comma separated দাও. যেটা আগে respond করে সেটার রেজাল্ট নেওয়া হয়,
# আর tx broadcast সব গুলোতেই একসাথে যায় (প্রথম যেটা mempool এ ঢোকে সেটাই জেতে)।
RPC_URLS=https://rpc.ankr.com/eth,https://eth.llamarpc.com
# WebSocket থাকলে new-block latency অনেক কমে (খুব recommended)
WS_RPC_URL=
# private relay (optional, frontrun/সex protection): Flashbots Protect / MEV Blocker
PRIVATE_RELAY_URLS=

# ---------- Wallet ----------
# burner wallet ব্যবহার করো. main wallet এর key কখনো এখানে দিও না।
PRIVATE_KEY=

# ---------- Gas policy ----------
GAS_LIMIT_BUFFER_PCT=25
PRIORITY_FEE_GWEI=3
PRIORITY_FEE_MULTIPLIER=1.5
BASE_FEE_MULTIPLIER=2
MAX_FEE_GWEI=200

# ---------- Safety ----------
# true থাকলে কোনো tx আসলে যাবে না, শুধু simulate হবে. প্রথমে এটাই রাখো।
DRY_RUN=true
# এক টাস্কে সর্বোচ্চ কত ETH খরচ হতে পারে
MAX_SPEND_ETH=0.2
# FCFS watcher কত ms পর পর mint-open চেক করবে
POLL_INTERVAL_MS=250
